[Unit]
Description=Verified private backup of Silent Narratives database and credentials
After=silent-narratives-v1.service
[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/workspace/silent-narratives-automation
ExecStart=/usr/bin/python3 ops/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/workspace/silent-narratives-automation/backups /home/ubuntu/workspace/silent-narratives-automation/data
